# Copy this file to `.env` and edit as needed. Every value is optional;
# the defaults below are what the app uses when a variable is not set.
# Real environment variables (e.g. set on Render/Railway) override .env.

# Where training saves the model and where the API loads it from.
MODEL_PATH=models/model.joblib

# Frontend URLs allowed to call this API from a browser (comma-separated).
# Add your deployed frontend, e.g. https://my-team-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
