# Vercel AI Gateway key — one key for OpenAI, Anthropic, Google and more.
# Create one at https://vercel.com/ai-gateway (free credits each month).
# Deployed on Vercel? OIDC auth works automatically and you can omit this.
AI_GATEWAY_API_KEY=your_ai_gateway_key_here

# Optional: any "provider/model" id from https://ai-gateway.vercel.sh/v1/models
# AI_MODEL=anthropic/claude-haiku-5.5
