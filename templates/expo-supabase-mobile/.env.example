# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Find them in the Supabase dashboard: Project Settings > API Keys (and Data API for the URL),
# or in the output of `npx supabase start` when running Supabase locally.
#
# Use the PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key.
# NEVER put the service_role / secret key here: everything starting with EXPO_PUBLIC_
# is bundled into the app, and anyone can read it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
